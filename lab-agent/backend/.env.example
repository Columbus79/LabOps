# PostgreSQL with pgvector. Keep this file free of real credentials.
DATABASE_URL=postgresql+psycopg://labops:replace-me@localhost:5432/labops
JWT_SECRET_KEY=replace-with-a-random-value-at-least-32-characters
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256
APP_ENV=development
CORS_ORIGINS=["http://localhost:5173"]
BUSINESS_TIMEZONE=Asia/Shanghai

# Optional until the corresponding AI feature is configured.
LLM_API_KEY=replace-me
LLM_MODEL=your-current-model
LLM_BASE_URL=https://your-existing-openai-compatible-endpoint/v1
SILICONFLOW_EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
EMBEDDING_DIMENSIONS=4096
RAG_MIN_SIMILARITY=0.15
UPLOAD_MAX_BYTES=10485760
AGENT_REQUEST_TIMEOUT_SECONDS=60
