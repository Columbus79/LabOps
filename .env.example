# Copy into a separate deployment .env only after verifying the existing labops
# PostgreSQL volume's database/user credentials. Do not replace backend/.env;
# that file contains the preserved original MySQL source configuration.
POSTGRES_DB=labops
POSTGRES_USER=labops
POSTGRES_PASSWORD=replace-with-the-existing-volume-password
LABOPS_DATABASE_URL=postgresql+psycopg://labops:replace-with-url-encoded-password@postgres:5432/labops
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256
APP_ENV=production
CORS_ORIGINS=["http://localhost:8080"]
BUSINESS_TIMEZONE=Asia/Shanghai
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
SILICONFLOW_EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
EMBEDDING_DIMENSIONS=4096
RAG_MIN_SIMILARITY=0.15
UPLOAD_MAX_BYTES=10485760
AGENT_REQUEST_TIMEOUT_SECONDS=60
HTTP_PORT=8080
APP_UID=501
